<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.TextScanner" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        
        <item name="alertDialogTheme">@style/CustomAlertDialogTheme</item>
        <item name="materialAlertDialogTheme">@style/CustomAlertDialogTheme</item>
    </style>

    <style name="Theme.TextScanner" parent="Base.Theme.TextScanner" />

    <style name="CustomAlertDialogTheme" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorPrimary">@color/black</item>
        <item name="android:textColorPrimary">@color/black</item>
        <item name="android:textColor">@color/black</item>
        
        <item name="textAppearanceButton">@style/CustomDialogButtonText</item>
    </style>

    <style name="CustomDialogButtonText" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textColor">@color/black</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="splashScreen" parent="Theme.AppCompat.Light">
        <item name="android:windowSplashScreenBackground">#fef6ff</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Base.Theme.TextScanner</item>
    </style>

    <!-- Drawer Item Style to increase text size -->
    <style name="DrawerTextAppearance" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>